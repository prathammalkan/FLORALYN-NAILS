# Floralyn Nails — Environment Variables
# ─────────────────────────────────────────────────────────────────
# LOCAL DEV: rename this file to .env.local
# VERCEL:    add each variable in Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────
# Get service_role key from:
#   supabase.com/dashboard → project → Settings → API → service_role (secret)
SUPABASE_URL=https://znycuzuveqhybqgevjvj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── Twilio WhatsApp ───────────────────────────────────────────────
# Get from: console.twilio.com → Account Info (top of dashboard)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# Sandbox number (use until you get an approved number):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your WhatsApp number (with country code, no spaces):
DEST_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# ── Resend (email notifications) ─────────────────────────────────
# Get from: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
OWNER_EMAIL=floralyyn7@gmail.com

# ── Telegram Notifications ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ── Admin Panel Credentials ──────────────────────────────────────
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# ── CORS ─────────────────────────────────────────────────────────
# Update after you know your Vercel URL (e.g. floralyn.vercel.app)
ALLOWED_ORIGIN=https://floralyn.vercel.app
