# ================================================================
# FLORALYN — Environment Variables Reference
# ================================================================
# 1. Copy this file to .env for local development:
#       cp .env.example .env
# 2. Fill in real values in .env
# 3. In production: set these in Vercel Dashboard →
#       Settings → Environment Variables
# 4. NEVER commit .env to version control (.gitignore covers it)
# ================================================================

# ─── Twilio WhatsApp ────────────────────────────────────────────
# Get these from: https://console.twilio.com/
# Used by: api/send-whatsapp.js (server-side only)

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio WhatsApp sender (sandbox: +14155238886, or approved number)
TWILIO_WHATSAPP_FROM=+14155238886

# Owner's WhatsApp number (include country code, no spaces)
DEST_WHATSAPP_TO=+91XXXXXXXXXX

# ─── Supabase ───────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard
# → your project → Settings → API
# Used by: api/send-whatsapp.js (server-side only — SERVICE ROLE KEY)

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# SERVICE ROLE KEY — full database access — NEVER expose in browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ─── CORS ───────────────────────────────────────────────────────
# Set to your production domain to restrict API calls
ALLOWED_ORIGIN=https://your-project.vercel.app

# ─── Admin Panel Supabase Credentials (browser-safe) ────────────
# These go into admin/js/dashboard.js — NOT committed to git
# The ANON KEY is safe for browser use because Row Level Security (RLS)
# enforces access control at the database level.
#
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
